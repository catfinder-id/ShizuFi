Options -Indexes
RedirectMatch 404 /(?:\.git|\.php-runtime|database|tests)(?:/|$)
<FilesMatch "(^config.*\.php$|^shizufi-config\.php$|\.sql$|\.test\.(cjs|php)$|^\.env|^\.git)">
 Require all denied
</FilesMatch>
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "same-origin"
 Header always set X-Frame-Options "DENY"
</IfModule>
